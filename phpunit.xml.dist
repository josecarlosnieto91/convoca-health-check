<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap-unit.php"
         colors="true"
         cacheResult="false">
  <testsuites>
    <testsuite name="unit">
      <directory suffix="Test.php">./tests/Unit</directory>
    </testsuite>
  </testsuites>
  <!--
    Se mide TODO el código de la herramienta: `lib/`, `health-check.php` y `observability.php`.

    Antes se medía solo `lib/` (78 sentencias) con la justificación de que `health-check.php` «se auto-ejecuta y
    termina en `exit()`, así que no hay forma de medirlo sin doblar medio WordPress». Lo primero era cierto y lo
    segundo no: el fichero se podía cargar como biblioteca. Se sacó el MAIN detrás de una guarda
    (`CONVOCA_HC_LIBRARY`) y sus 27 funciones se prueban desde `tests/Unit/`. Un 99,5 % sobre 78 sentencias no
    decía nada del instrumento; el número honesto es el de ahora, sobre ~1.200.
  -->
  <source>
    <include>
      <directory>lib</directory>
      <file>health-check.php</file>
      <file>observability.php</file>
    </include>
  </source>
</phpunit>
