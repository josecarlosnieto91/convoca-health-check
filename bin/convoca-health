#!/usr/bin/env bash
# convoca-health — un único comando para validar todo el ecosistema Convoca.
#
# Uso:
#   convoca-health                      # ejecuta contra el WP por defecto
#   convoca-health --path=/ruta/al/wp   # WP en otra ruta
#   convoca-health --ssh=andromeda --path=/var/www/.../public
#
# Código de salida: 0 = todos los checks PASS (puede haber WARN y SKIP);
# 1 = hay al menos un FAIL. Es el código de salida de la propia batería, no una
# búsqueda de la palabra «FAIL» en la salida: la línea de resumen contiene
# siempre «0 FAIL» o «N FAIL», así que un `grep -q FAIL` daba 1 siempre y el
# código de salida dejaba de distinguir el caso bueno del malo.
#
# Requiere: WP-CLI en el servidor destino.

set -uo pipefail

WP_PATH="${WP_PATH:-}"
SSH_TARGET=""
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPT="$SCRIPT_DIR/../health-check.php"

for arg in "$@"; do
  case "$arg" in
    --path=*) WP_PATH="${arg#*=}" ;;
    --ssh=*) SSH_TARGET="${arg#*=}" ;;
    --format=*) FORMAT="${arg#*=}" ;;
    *) echo "Argumento desconocido: $arg" >&2; exit 2 ;;
  esac
done

WP_ARGS=""
[ -n "$WP_PATH" ] && WP_ARGS="--path=$WP_PATH"

run_local() {
  wp eval-file "$SCRIPT" $WP_ARGS
}

run_ssh() {
  # El script NO viaja solo: `lib/` va al lado, porque con `wp eval-file` los require son relativos al
  # directorio de evaluación. Subir solo el script daba un fatal «Failed opening required /tmp/lib/…» que se
  # leía como una caída del sitio (medido: la batería «reventaba» contra un sitio que estaba perfecto).
  local REMOTO="/tmp/convoca-health-run"
  ssh "$SSH_TARGET" "rm -rf $REMOTO && mkdir -p $REMOTO/lib" || return 2
  scp -q "$SCRIPT" "$SSH_TARGET:$REMOTO/health-check.php" || return 2
  scp -q -r "$SCRIPT_DIR/../lib/." "$SSH_TARGET:$REMOTO/lib/" || return 2
  # Esperar a que scp termine antes de wp (fish en Andromeda)
  sleep 2
  ssh "$SSH_TARGET" "sudo -n wp eval-file $REMOTO/health-check.php --allow-root $WP_ARGS 2>&1"
  local SALIDA=$?
  ssh "$SSH_TARGET" "rm -rf $REMOTO" 2>/dev/null
  return $SALIDA
}

echo "== Convoca Health Check =="

if [ -n "$SSH_TARGET" ]; then
  OUTPUT="$(run_ssh)"
else
  OUTPUT="$(run_local)"
fi
STATUS=$?

echo "$OUTPUT"
exit "$STATUS"
