<?xml version="1.0"?>
<!-- Vara de PHPMD para Convoca. Solo tamaño y complejidad: lo demás lo cubren PHPCS/PHPStan. -->
<ruleset name="ConvocaMetrics">
  <description>Umbrales de mantenibilidad del ecosistema Convoca.</description>

  <rule ref="rulesets/codesize.xml/CyclomaticComplexity">
    <properties><property name="reportLevel" value="10"/></properties>
  </rule>
  <rule ref="rulesets/codesize.xml/NPathComplexity">
    <properties><property name="minimum" value="200"/></properties>
  </rule>
  <rule ref="rulesets/codesize.xml/ExcessiveMethodLength">
    <properties><property name="minimum" value="50"/></properties>
  </rule>
  <rule ref="rulesets/codesize.xml/ExcessiveParameterList">
    <properties><property name="minimum" value="4"/></properties>
  </rule>
  <rule ref="rulesets/codesize.xml/ExcessiveClassLength">
    <properties><property name="minimum" value="1000"/></properties>
  </rule>
  <rule ref="rulesets/codesize.xml/TooManyMethods">
    <properties><property name="maxmethods" value="25"/></properties>
  </rule>
</ruleset>
